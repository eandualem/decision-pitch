# Copy this file to .env and fill in the keys for the models you want to play.
# .env is ignored by git. A variable already set in your shell takes precedence.
# The names are Decision Arena's, so one .env serves both.

# Jev at TypeSafe: uv run decision-pitch --home jev
TYPESAFE_API_KEY=

# OpenAI's Decisions API (GPT-6 Luna Decisions): --home openai
OPENAI_API_KEY=

# Perplexity's Decisions API (Perplexity Decider): --home perplexity
PERPLEXITY_API_KEY=

# Vercel's AI Gateway: Microsoft Decision-1 and Liquid D1: --home microsoft, --home liquid
AI_GATEWAY_API_KEY=

# EmpirioLabs' Aplomb 1: --home aplomb
EMPIRIO_LABS_API_KEY=

# Cloudflare's Clef-flash on Workers AI: --home clef
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AUTH_TOKEN=

# Laya runs on this computer and needs no key (install it with: uv tool install 'laya[serve]').

# Optional manager prompt/response tracing: uv sync --extra tracing
# Both keys enable export of game prompts and answers to this Langfuse project.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
